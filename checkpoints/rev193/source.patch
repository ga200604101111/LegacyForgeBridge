+package dev.yinghuang.legacyforgebridge.compat;
+
+import com.google.gson.JsonObject;
+import com.mojang.serialization.JsonOps;
+import dev.yinghuang.legacyforgebridge.LegacyForgeBridge;
+import dev.yinghuang.legacyforgebridge.convert.LegacyVanillaStackDataFix;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.resources.RegistryOps;
+import net.minecraft.world.item.ItemStack;
+
+/** Native bridge display-stack resolution. DFU, not per-mod tables, owns vanilla flattening. */
+public final class LegacyVanillaDisplayStacks {
+    private static final LegacyDisplayStackCache<ItemStack> CACHE = new LegacyDisplayStackCache<>(2048);
+    private static final LegacyDisplayStackCache.Backend<ItemStack> BACKEND = new RuntimeBackend();
+    private static final java.util.concurrent.atomic.AtomicBoolean WARNED = new java.util.concurrent.atomic.AtomicBoolean();
+    private LegacyVanillaDisplayStacks() { }
+
+    /** Null means retain the original modded/unknown-item implementation. Never changes a packet. */
+    public static ItemStack tryVanilla(int legacyId, int count, int metadata) {
+        try {
+            return CACHE.resolve(legacyId, count, metadata, BACKEND);
+        } catch (RuntimeException | LinkageError error) {
+            if (WARNED.compareAndSet(false, true))
+                LegacyForgeBridge.LOGGER.warn("Vanilla display-stack migration failed; retaining the original visual path: {}", error.toString());
+            return null;
+        }
+    }
+
+    private static final class RuntimeBackend implements LegacyDisplayStackCache.Backend<ItemStack> {
+        @Override public String identity(int id) {
+            var identity = LegacyModItemRegistryMap.legacyAnyIdentity(id);
+            return identity == null ? null : identity.toString();
+        }
+        @Override public Object world() { return Minecraft.getInstance().level; }
+        @Override public ItemStack migrate(String identity, int metadata, Object world) {
+            var fixed = LegacyVanillaStackDataFix.upgrade(identity, metadata);
+            JsonObject value = new JsonObject();
+            value.addProperty("id", fixed.id());
+            value.add("components", fixed.components());
+            var ops = RegistryOps.create(JsonOps.INSTANCE, ((ClientLevel) world).registryAccess());
+            ItemStack stack = ItemStack.CODEC.parse(ops, value).result().orElse(null);
+            if (stack == null || stack.isEmpty()) return null;
+            // Keep the raw subtype separately; do not turn a flower variant into durability.
+            LegacyStackComponents.set(stack, metadata);
+            return stack;
+        }
+        @Override public ItemStack copy(ItemStack stack) { return stack.copy(); }
+        @Override public int maxCount(ItemStack stack) { return stack.getMaxStackSize(); }
+        @Override public void count(ItemStack stack, int count) { stack.setCount(count); }
+    }
+}
