diff --git a/src/test/java/dev/yinghuang/legacyforgebridge/compat/LegacyDisplayStackCacheTest.java b/src/test/java/dev/yinghuang/legacyforgebridge/compat/LegacyDisplayStackCacheTest.java
new file mode 100644
index 0000000..2a84c61
--- /dev/null
+++ b/src/test/java/dev/yinghuang/legacyforgebridge/compat/LegacyDisplayStackCacheTest.java
@@ -0,0 +1,82 @@
+package dev.yinghuang.legacyforgebridge.compat;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Tests orchestration with an explicit fake backend; does NOT claim Minecraft DFU/render tests. */
+public final class LegacyDisplayStackCacheTest {
+    static int checks;
+    static final class Stack {
+        final String identity; final int metadata; int count; int maximum = 64;
+        Stack(String identity, int metadata) { this.identity = identity; this.metadata = metadata; }
+        Stack copy() { Stack out = new Stack(identity, metadata); out.count = count; out.maximum = maximum; return out; }
+    }
+    static final class Fake implements LegacyDisplayStackCache.Backend<Stack> {
+        final Map<Integer, String> identities = new HashMap<>();
+        Object world = new Object(); int migrations, identityCalls; boolean fail; Stack lastTemplate;
+        public String identity(int id) { identityCalls++; return identities.get(id); }
+        public Object world() { return world; }
+        public Stack migrate(String identity, int metadata, Object world) {
+            migrations++; if (fail) return null;
+            return lastTemplate = new Stack(identity, metadata);
+        }
+        public Stack copy(Stack stack) { return ((Stack) stack).copy(); }
+        public int maxCount(Stack stack) { return ((Stack) stack).maximum; }
+        public void count(Stack stack, int count) { ((Stack) stack).count = count; }
+    }
+    static void check(boolean condition, String message) {
+        checks++; if (!condition) throw new AssertionError(message);
+    }
+    @org.junit.jupiter.api.Test
+    void nativeCacheRegression() throws Exception { main(new String[0]); }
+
+    public static void main(String[] args) throws Exception {
+        checks = 0;
+        Fake api = new Fake(); LegacyDisplayStackCache<Stack> resolver = new LegacyDisplayStackCache<>(3);
+        api.identities.put(357, "minecraft:cookie"); api.identities.put(38, "minecraft:red_flower");
+        api.identities.put(37, "minecraft:yellow_flower"); api.identities.put(4240, "example:food");
+        check(resolver.resolve(-1, 1, 0, api) == null, "negative/null stack id preserved");
+        check(resolver.resolve(357, 0, 0, api) == null, "zero-count sentinel not fabricated");
+        check(resolver.resolve(357, -1, 0, api) == null, "negative count rejected");
+        check(resolver.resolve(357, 256, 0, api) == null, "invalid count rejected");
+        check(resolver.resolve(357, 1, -1, api) == null, "negative metadata rejected");
+        check(resolver.resolve(357, 1, 65536, api) == null, "invalid metadata rejected");
+        check(api.identityCalls == 0, "invalid data does not enter runtime registry");
+        check(resolver.resolve(9999, 1, 0, api) == null, "unknown id stays original");
+        check(resolver.resolve(4240, 1, 7, api) == null, "modded subtype stays original");
+        check(api.migrations == 0, "no DFU on unknown/modded stacks");
+        Stack cookie = (Stack) resolver.resolve(357, 1, 0, api);
+        check(cookie.identity.equals("minecraft:cookie"), "FML identity passed to backend");
+        check(cookie.count == 1, "source count preserved");
+        check(cookie != api.lastTemplate, "template is not returned mutable");
+        cookie.count = 33;
+        Stack cookie2 = (Stack) resolver.resolve(357, 2, 0, api);
+        check(cookie2.count == 2 && cookie2 != cookie, "fresh copy per render");
+        check(api.migrations == 1, "repeated render avoids repeated migration");
+        check(((Stack) resolver.resolve(357, 255, 0, api)).count == 64, "count clamped to item maximum");
+        Stack flower0 = (Stack) resolver.resolve(38, 1, 0, api);
+        Stack flower8 = (Stack) resolver.resolve(38, 1, 8, api);
+        check(flower0.metadata == 0 && flower8.metadata == 8, "flower subtype forwarded, not collapsed");
+        check(api.migrations == 3, "subtype occupies distinct cache entry");
+        check(resolver.size() == 3, "cache contains distinct item/metadata entries");
+        resolver.resolve(37, 1, 0, api);
+        check(resolver.size() == 3, "cache bounded after new item");
+        int before = api.migrations; resolver.resolve(357, 1, 0, api);
+        check(api.migrations == before + 1, "evicted entry recomputed");
+        api.identities.put(357, "minecraft:bread");
+        Stack remapped = (Stack) resolver.resolve(357, 1, 0, api);
+        check(remapped.identity.equals("minecraft:bread"), "numeric registry rebind cannot return stale cookie");
+        api.world = new Object(); before = api.migrations;
+        resolver.resolve(357, 1, 0, api);
+        check(api.migrations == before + 1 && resolver.size() == 1, "world switch invalidates templates");
+        api.world = null;
+        check(resolver.resolve(357, 1, 0, api) == null && resolver.size() == 0, "disconnect returns original and clears cache");
+        api.world = new Object(); api.fail = true; before = api.migrations;
+        check(resolver.resolve(357, 1, 0, api) == null, "failed migration does not fabricate item");
+        check(resolver.resolve(357, 1, 0, api) == null && api.migrations == before + 2, "failure not cached permanently");
+        api.fail = false;
+        check(resolver.resolve(357, 1, 0, api) != null, "late available registry can recover");
+        check(resolver.size() == 1, "successful recovery enters cache");
+        System.out.println("PASS: " + checks + " isolated resolver assertions (fake backend; no game/DFU execution)");
+    }
+}
