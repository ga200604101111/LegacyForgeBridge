@@ -0,0 +1,52 @@
+package dev.yinghuang.legacyforgebridge.compat;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Bounded visual-stack templates, scoped to the live client world and FML identity. */
+public final class LegacyDisplayStackCache<T> {
+    public interface Backend<T> {
+        String identity(int legacyId);
+        Object world();
+        T migrate(String identity, int metadata, Object world);
+        T copy(T stack);
+        int maxCount(T stack);
+        void count(T stack, int count);
+    }
+    private record Key(String identity, int metadata) { }
+    private final int capacity;
+    private final Map<Key, T> templates = new LinkedHashMap<>(16, 0.75f, true);
+    private Object world;
+
+    public LegacyDisplayStackCache(int capacity) {
+        if (capacity < 1) throw new IllegalArgumentException("capacity");
+        this.capacity = capacity;
+    }
+
+    /** Null leaves the caller's existing modded/unknown-item path in control. */
+    public synchronized T resolve(int id, int count, int meta, Backend<T> api) {
+        if (id < 0 || count <= 0 || count > 255 || meta < 0 || meta > 65535) return null;
+        // Never memoize numeric ids: FML may replace their identities between sessions.
+        String identity = api.identity(id);
+        if (identity == null || !identity.startsWith("minecraft:") || identity.length() <= 10) return null;
+        Object currentWorld = api.world();
+        if (currentWorld != world) { templates.clear(); world = currentWorld; }
+        if (world == null) return null;
+        Key key = new Key(identity, meta);
+        T template = templates.get(key);
+        if (template == null) {
+            template = api.migrate(identity, meta, world);
+            // A temporarily unavailable registry must be retried, not negatively cached.
+            if (template == null) return null;
+            if (templates.size() >= capacity) templates.remove(templates.keySet().iterator().next());
+            templates.put(key, template);
+        }
+        T result = api.copy(template);
+        int maximum = api.maxCount(result);
+        if (maximum < 1) return null;
+        api.count(result, Math.min(count, maximum));
+        return result;
+    }
+
+    public synchronized int size() { return templates.size(); }
+}
