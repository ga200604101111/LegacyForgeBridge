@@ -0,0 +1,121 @@
+package dev.yinghuang.legacyforgebridge.desktop;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.concurrent.*;
+import java.util.function.BooleanSupplier;
+
+/** Bounded startup-only control pump. The worker queues tasks; ONLY the captured client thread
+ * may inspect game state or request graceful shutdown. A stalled executor cancels, never kills. */
+public final class DesktopRestartPump implements AutoCloseable {
+    private final Path session, current;
+    private final String id;
+    private final Executor clientExecutor;
+    private final Thread clientThread;
+    private final BooleanSupplier clientStep;
+    private final ScheduledExecutorService timer;
+    private final long initialTimeout, responseTimeout;
+    private volatile boolean closed;
+    private boolean pending;
+    private long queuedAt, queuedEpoch, completedEpoch, submitted, completed;
+    private String state = "STARTING", reason = "";
+
+    private DesktopRestartPump(Path session, Executor executor, Thread owner, BooleanSupplier step,
+            long initialTimeout, long responseTimeout) throws IOException {
+        this.session = session.toRealPath(); DesktopFiles.noLinks(this.session);
+        Properties p = DesktopFiles.read(this.session.resolve("status.properties"));
+        this.id = p.getProperty("session", "");
+        Path game = DesktopFiles.absolute(p.getProperty("game")).toRealPath();
+        if (!id.matches("[0-9a-f-]{36}") || !this.session.equals(game.resolve("legacy-cache/desktop/sessions").resolve(id)))
+            throw new IOException("Restart pump session mismatch");
+        this.current = game.resolve("legacy-cache/desktop/current.properties");
+        clientExecutor = Objects.requireNonNull(executor);
+        clientThread = Objects.requireNonNull(owner);
+        clientStep = Objects.requireNonNull(step);
+        if (initialTimeout <= 0 || responseTimeout <= 0) throw new IllegalArgumentException("Restart pump timeouts");
+        this.initialTimeout = initialTimeout; this.responseTimeout = responseTimeout;
+        timer = Executors.newSingleThreadScheduledExecutor(r -> {
+            Thread t = new Thread(r, "LFB-desktop-restart-pump"); t.setDaemon(true); return t;
+        });
+        publish();
+    }
+    public static DesktopRestartPump start(Path session, Executor executor, Thread owner, BooleanSupplier step) throws IOException {
+        DesktopRestartPump pump = new DesktopRestartPump(session, executor, owner, step,
+            TimeUnit.SECONDS.toNanos(120), TimeUnit.SECONDS.toNanos(15));
+        pump.timer.scheduleWithFixedDelay(pump::pulse, 0, 250, TimeUnit.MILLISECONDS);
+        return pump;
+    }
+    private void pulse() {
+        try {
+            synchronized (this) {
+                if (closed) return;
+                if (!DesktopFiles.signalMatches(current, id) || DesktopFiles.signalMatches(session.resolve("cancel.properties"), id)) {
+                    finish("CANCELED", "session_changed_or_canceled"); return;
+                }
+                if (pending) {
+                    if (System.nanoTime() - queuedAt >= (completed == 0 ? initialTimeout : responseTimeout)) {
+                        abort("TIMED_OUT", "client_executor_not_responding"); return;
+                    }
+                    state = "WAITING_MAIN"; publish(); return;
+                }
+                pending = true; queuedAt = System.nanoTime(); queuedEpoch = System.currentTimeMillis(); submitted++;
+                state = "QUEUED"; publish();
+            }
+            // Do not hold the pump lock while calling an external executor.
+            clientExecutor.execute(this::runOnClient);
+        } catch (Exception | LinkageError failure) {
+            abortQuietly("FAILED", failure.getClass().getName());
+        }
+    }
+    private void runOnClient() {
+        synchronized (this) {
+            if (closed) return; // A late queued callback must not revive a timed-out session.
+            if (Thread.currentThread() != clientThread) {
+                abortQuietly("FAILED", "wrong_client_thread"); return;
+            }
+            if (!DesktopFiles.signalMatches(current, id) || DesktopFiles.signalMatches(session.resolve("cancel.properties"), id)) {
+                try { finish("CANCELED", "session_changed_or_canceled"); }
+                catch (IOException e) { abortQuietly("FAILED", e.getClass().getName()); }
+                return;
+            }
+        }
+        try {
+            boolean again = clientStep.getAsBoolean();
+            synchronized (this) {
+                if (closed) return;
+                completed++; completedEpoch = System.currentTimeMillis(); pending = false;
+                if (!again) finish("CONTROL_FINISHED", "no_further_automatic_exit_work");
+                else { state = "ACTIVE"; publish(); }
+            }
+        } catch (Exception | LinkageError failure) { abortQuietly("FAILED", failure.getClass().getName()); }
+    }
+    private synchronized void abortQuietly(String state, String reason) {
+        try { abort(state, reason); }
+        catch (IOException ignored) { closed = true; timer.shutdown(); }
+    }
+    private synchronized void abort(String state, String reason) throws IOException {
+        if (closed) return;
+        // The normal client poll also checks this marker. No approval/launcher claim is created.
+        try { DesktopFiles.signal(session.resolve("pump-failed.properties"), id); }
+        finally { finish(state, reason); }
+    }
+    private synchronized void finish(String state, String reason) throws IOException {
+        this.state = state; this.reason = reason; closed = true; timer.shutdown(); publish();
+    }
+    private synchronized void publish() throws IOException {
+        Properties p = new Properties(); p.setProperty("session", id); p.setProperty("state", state);
+        p.setProperty("reason", DesktopFiles.text(reason, 160)); p.setProperty("driver", "CLIENT_EXECUTOR");
+        p.setProperty("updated", Long.toString(System.currentTimeMillis()));
+        p.setProperty("submitted", Long.toString(submitted)); p.setProperty("completed", Long.toString(completed));
+        p.setProperty("pending", Boolean.toString(pending)); p.setProperty("queuedEpoch", Long.toString(queuedEpoch));
+        p.setProperty("completedEpoch", Long.toString(completedEpoch));
+        DesktopFiles.write(session.resolve("pump.properties"), p);
+    }
+    public boolean isClosed() { return closed; }
+    @Override public synchronized void close() {
+        if (!closed) try { finish("CLOSED", "coordinator_replaced"); }
+        catch (IOException ignored) { closed = true; timer.shutdown(); }
+    }
+}
