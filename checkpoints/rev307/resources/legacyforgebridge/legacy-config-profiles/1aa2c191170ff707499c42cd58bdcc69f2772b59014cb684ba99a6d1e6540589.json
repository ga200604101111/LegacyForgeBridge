    },
    {
      "file": "TwilightForest.cfg",
      "category": "dimension",
      "key": "dimensionProviderID",
      "type": "I",
      "default": "-777",
      "comment": "Dimension provider ID.  Does not normally need to be changed, but the option is provided to work around a bug in MCPC+",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "general",
      "key": "AdminOnlyPortals",
      "type": "B",
      "default": "false",
      "comment": "Allow portals only for admins (ops).  This severly reduces the range in which the mod usually scans for valid portal conditions, and it scans near ops only.",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "general",
      "key": "AllowPortalsInOtherDimensions",
      "type": "B",
      "default": "false",
      "comment": "Allow portals to the Twilight Forest to be made outside of dimension 0.  May be considered an exploit.",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "general",
      "key": "DisablePortalCreation",
      "type": "B",
      "default": "false",
      "comment": "Disable Twilight Forest portal creation entirely.  Provided for server operators looking to restrict action to the dimension.",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "general",
      "key": "DisableUncrafting",
      "type": "B",
      "default": "false",
      "comment": "Disable the uncrafting function of the uncrafting table.  Provided as an option when interaction with other mods produces exploitable recipes.",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "general",
      "key": "OldMapGen",
      "type": "B",
      "default": "false",
      "comment": "Use old (pre Minecraft 1.7) map gen.  May not be fully supported.",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "general",
      "key": "PortalCreationItem",
      "type": "S",
      "default": "diamond",
      "comment": "Item to create the Twilight Forest Portal.  Defaults to \\'diamond\\'",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "general",
      "key": "SilentCicadas",
      "type": "B",
      "default": "false",
      "comment": "Make cicadas silent  for those having sound library problems, or otherwise finding them annoying",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "Performance",
      "key": "CanopyCoverage",
      "type": "D",
      "default": "1.7",
      "comment": "Amount of canopy coverage, from 0.0 on up.  Lower numbers improve chunk generation speed at the cost of a thinner forest.",
      "scope": "instance-config"
    },
    {
      "file": "TwilightForest.cfg",
      "category": "Performance",
      "key": "TwilightOakChance",
      "type": "I",
      "default": "48",
      "comment": "Chance that a chunk in the Twilight Forest will contain a twilight oak tree.  Higher numbers reduce the number of trees, increasing performance.",
