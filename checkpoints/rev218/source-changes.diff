+package dev.yinghuang.legacyforgebridge;
+
+import dev.yinghuang.legacyforgebridge.desktop.DesktopConversionSession;
+import net.fabricmc.loader.api.entrypoint.PreLaunchEntrypoint;
+
+/** Earliest Fabric Loader bootstrap for local conversion coordination/status only. */
+public final class LegacyForgeBridgePreLaunch implements PreLaunchEntrypoint {
+    @Override
+    public void onPreLaunch() {
+        DesktopConversionSession.preLaunch();
+    }
+}
