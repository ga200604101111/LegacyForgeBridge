{
  "schemaVersion": 1,
  "id": "legacyforgebridge",
  "version": "${version}",
  "name": "LegacyForgeBridge",
  "description": "Fabric 1.21.11 compatibility and conversion layer for legacy Forge 1.7.10 mods.",
  "authors": [
    "YingHunag09"
  ],
  "contact": {
    "sources": "https://github.com/ga200604101111/LegacyForgeBridge"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.yinghuang.legacyforgebridge.LegacyForgeBridge"
    ],
    "client": [
      "dev.yinghuang.legacyforgebridge.LegacyForgeBridgeClient",
      "dev.yinghuang.legacyforgebridge.ConvertedRenderingClient",
      "dev.yinghuang.legacyforgebridge.behavior.LegacyBehaviorClient"
    ],
    "viafabricplus": [
      "dev.yinghuang.legacyforgebridge.protocol.ViaFabricPlusEntrypoint"
    ]
  },
  "mixins": [
    "legacyforgebridge.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "team_reborn_energy": ">=4.2.0",
    "viafabricplus": ">=4.4.15"
  }
}
